@model PhoneShop.Models.Order

@{
    ViewData["Title"] = "Chi tiết đơn hàng";

    var culture =
        System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    var status = Model.Status switch
    {
        PhoneShop.Models.OrderStatus.Pending => "Chờ xác nhận",
        PhoneShop.Models.OrderStatus.Confirmed => "Đã xác nhận",
        PhoneShop.Models.OrderStatus.Shipping => "Đang giao",
        PhoneShop.Models.OrderStatus.Delivered => "Đã giao",
        PhoneShop.Models.OrderStatus.Cancelled => "Đã hủy",
        _ => "Không xác định"
    };

    var statusClass = Model.Status switch
    {
        PhoneShop.Models.OrderStatus.Pending => "bg-warning text-dark",
        PhoneShop.Models.OrderStatus.Confirmed => "bg-primary",
        PhoneShop.Models.OrderStatus.Shipping => "bg-info text-dark",
        PhoneShop.Models.OrderStatus.Delivered => "bg-success",
        PhoneShop.Models.OrderStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };

    var paymentStatus = Model.PaymentStatus switch
    {
        PhoneShop.Models.PaymentStatus.Paid => "Đã thanh toán",
        PhoneShop.Models.PaymentStatus.Refunded => "Đã hoàn tiền",
        _ => "Chưa thanh toán"
    };

    var paymentClass = Model.PaymentStatus switch
    {
        PhoneShop.Models.PaymentStatus.Paid => "bg-success",
        PhoneShop.Models.PaymentStatus.Refunded => "bg-secondary",
        _ => "bg-warning text-dark"
    };

    var paymentMethod = Model.PaymentMethod switch
    {
        PhoneShop.Models.PaymentMethod.CashOnDelivery =>
            "Thanh toán khi nhận hàng",

        PhoneShop.Models.PaymentMethod.BankTransfer =>
            "Chuyển khoản ngân hàng",

        _ => "Không xác định"
    };

    var canCancel =
        Model.Status == PhoneShop.Models.OrderStatus.Pending &&
        Model.PaymentStatus == PhoneShop.Models.PaymentStatus.Unpaid;
}

<a asp-controller="Orders"
   asp-action="Index"
   class="btn btn-outline-secondary mb-4">
    ← Đơn hàng của tôi
</a>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-2">Đơn hàng #@Model.Id</h1>

        <p class="text-muted mb-0">
            Ngày đặt:
            @(Model.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
            (giờ Việt Nam)
        </p>
    </div>

    <span class="badge @statusClass fs-6 px-3 py-2">
        @status
    </span>
</div>

@if (TempData["OrderSuccess"] is string success)
{
    <div class="alert alert-success">@success</div>
}

@if (TempData["OrderError"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card card-body h-100">
            <h4 class="mb-3">Thông tin nhận hàng</h4>

            <p>
                <strong>Người nhận:</strong>
                @Model.ReceiverName
            </p>

            <p>
                <strong>Điện thoại:</strong>
                @Model.PhoneNumber
            </p>

            <p class="mb-0 text-break">
                <strong>Địa chỉ:</strong>
                @Model.ShippingAddress
            </p>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card card-body h-100">
            <h4 class="mb-3">Thông tin thanh toán</h4>

            <p>
                <strong>Phương thức:</strong>
                @paymentMethod
            </p>

            <p class="mb-0">
                <strong>Thanh toán:</strong>

                <span class="badge @paymentClass ms-1">
                    @paymentStatus
                </span>
            </p>

            @if (Model.PaymentStatus ==
                PhoneShop.Models.PaymentStatus.Paid &&
                Model.PaidAtUtc.HasValue)
            {
                <p class="text-muted small mt-3 mb-0">
                    Xác nhận thanh toán:
                    @(Model.PaidAtUtc.Value.AddHours(7).ToString("dd/MM/yyyy HH:mm"))
                    (giờ Việt Nam)
                </p>
            }
        </div>
    </div>
</div>

<h4 class="mb-3">Sản phẩm trong đơn</h4>

<div class="table-responsive mb-4">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th class="text-center">Số lượng</th>
                <th class="text-end">Thành tiền</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <strong>@item.ProductName</strong>
                    </td>

                    <td class="text-nowrap">
                        @(item.UnitPrice.ToString("N0", culture)) ₫
                    </td>

                    <td class="text-center">
                        @item.Quantity
                    </td>

                    <td class="text-end text-nowrap fw-semibold">
                        @((item.UnitPrice * item.Quantity).ToString("N0", culture)) ₫
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row justify-content-end mb-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-body">
            <h4 class="mb-3">Tổng tiền đơn hàng</h4>

            <div class="d-flex justify-content-between gap-3 mb-3">
                <span>Tổng trước giảm</span>

                <strong class="text-nowrap">
                    @(Model.Subtotal.ToString("N0", culture)) ₫
                </strong>
            </div>

            @if (Model.DiscountAmount > 0)
            {
                <div class="d-flex justify-content-between gap-3 mb-3">
                    <span>Mã khuyến mãi</span>

                    <strong class="text-break">
                        @Model.PromotionCode
                    </strong>
                </div>
            }

            <div class="d-flex justify-content-between gap-3 text-success mb-3">
                <span>Giảm giá</span>

                <strong class="text-nowrap">
                    −@(Model.DiscountAmount.ToString("N0", culture)) ₫
                </strong>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border-top pt-3">
                <strong>Tổng tiền sau giảm</strong>

                <strong class="text-danger fs-4 text-nowrap">
                    @(Model.TotalAmount.ToString("N0", culture)) ₫
                </strong>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">
        Tiếp tục mua sắm
    </a>

    @if (canCancel)
    {
        <form asp-controller="Orders"
              asp-action="Cancel"
              method="post"
              class="m-0"
              onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn hàng này?');">

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn btn-outline-danger">
                Hủy đơn hàng
            </button>
               </form>
    }
</div>