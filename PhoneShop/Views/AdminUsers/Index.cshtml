@model List<PhoneShop.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Quản lý tài khoản";

    var adminCount = Model.Count(u => u.IsAdmin);
    var customerCount = Model.Count(u => !u.IsAdmin);
    var lockedCount = Model.Count(u => u.IsLocked);
}

<h1 class="mb-2">Quản lý tài khoản</h1>

<p class="text-muted mb-4">
    Theo dõi tài khoản và quản lý trạng thái truy cập của khách hàng.
</p>

@if (TempData["UserSuccess"] is string success)
{
    <div class="alert alert-success" role="status">
        @success
    </div>
}

@if (TempData["UserError"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card card-body h-100">
            <span class="text-muted">Tổng tài khoản</span>
            <strong class="fs-3 mt-2">@Model.Count</strong>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card card-body h-100">
            <span class="text-muted">Quản trị viên</span>
            <strong class="fs-3 mt-2">@adminCount</strong>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card card-body h-100">
            <span class="text-muted">Khách hàng</span>
            <strong class="fs-3 mt-2">@customerCount</strong>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card card-body h-100">
            <span class="text-muted">Đang bị khóa</span>
            <strong class="fs-3 mt-2 text-danger">
                @lockedCount
            </strong>
        </div>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card card-body text-center py-5">
        <h4>Chưa có tài khoản nào</h4>

        <p class="text-muted mb-0">
            Các tài khoản đã đăng ký sẽ xuất hiện tại đây.
        </p>
    </div>
}
else
{
    <div class="table-responsive mb-4">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            @user.FullName
                        </td>

                        <td class="text-break">
                            @user.Email
                        </td>

                        <td>
                            <span class="badge @(user.IsAdmin
                                ? "bg-primary"
                                : "bg-secondary") px-3 py-2">
                                @(user.IsAdmin
                                    ? "Quản trị viên"
                                    : "Khách hàng")
                            </span>
                        </td>

                        <td>
                            <span class="badge @(user.IsLocked
                                ? "bg-danger"
                                : "bg-success") px-3 py-2">
                                @(user.IsLocked
                                    ? "Đang bị khóa"
                                    : "Hoạt động")
                            </span>
                        </td>

                        <td class="text-end">
                            @if (user.IsAdmin)
                            {
                                <span class="text-muted small">
                                    Tài khoản quản trị
                                </span>
                            }
                            else
                            {
                                <form asp-controller="AdminUsers"
                                      asp-action="SetLock"
                                      method="post"
                                      class="m-0"
                                      onsubmit="return confirm('Bạn xác nhận thay đổi trạng thái khóa của tài khoản này?');">

                                    <input type="hidden"
                                           name="id"
                                           value="@user.Id" />

                                    <input type="hidden"
                                           name="locked"
                                           value="@(user.IsLocked ? "false" : "true")" />

                                    <button type="submit"
                                            class="btn btn-sm text-nowrap @(user.IsLocked
                                                ? "btn-outline-success"
                                                : "btn-outline-danger")">
                                        @(user.IsLocked
                                            ? "Mở khóa"
                                            : "Khóa tài khoản")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}